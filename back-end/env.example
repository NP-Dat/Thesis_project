# =====================================================================
# Industrial Employee Burnout Detection System – backend env template.
# Copy to `.env` and fill in real values. Never commit `.env`.
# =====================================================================

# ----- Application -----
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins. Use "*" to allow any.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ----- MySQL (relational) -----
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CONNECTION_LIMIT=10
# Set to "true" when connecting to a managed cloud DB that requires TLS.
MYSQL_SSL=false

# ----- MongoDB (documents) -----
# Full connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=
MONGODB_DB_NAME=burnout_detection

# ----- Authentication -----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ----- AI service -----
# When AI_USE_MOCK=true the backend uses an in-process stub and ignores
# AI_SERVICE_URL. Flip to false once the Python/FastAPI service is online.
AI_USE_MOCK=true
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=5000

# ----- Alert thresholds -----
# Burn-rate jump (between two consecutive assessments) that triggers a
# "trend_spike" alert. Default 0.15 matches documents/general-flow.md.
ALERT_TREND_SPIKE_DELTA=0.15

# ----- Admin bootstrap (used only by `npm run seed`) -----
ADMIN_EMAIL=admin@factory.com
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
