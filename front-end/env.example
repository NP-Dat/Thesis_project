# =====================================================================
# Burnout Detection System – Frontend env template.
# Copy to `.env.local` and fill in values. Never commit `.env.local`.
# =====================================================================

# Dev server port is set via `-p` flag in package.json scripts (default: 5173).

# Base URL of the Express backend API (no trailing slash).
# Defaults to http://localhost:3000/api if not set.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
